[
  {
    "name": "openai_chat_stream_basic",
    "description": "Basic OpenAI streaming: role chunk → content deltas → finish_reason → [DONE]",
    "inbound_format": "openai_chat",
    "outbound_format": "openai_chat",
    "stream": true,
    "client_request": {
      "model": "gpt-4o",
      "messages": [{ "role": "user", "content": "Hi" }],
      "stream": true
    },
    "provider_stream_chunks": [
      { "id": "c1", "object": "chat.completion.chunk", "model": "gpt-4o", "choices": [{ "index": 0, "delta": { "role": "assistant" } }] },
      { "id": "c1", "object": "chat.completion.chunk", "model": "gpt-4o", "choices": [{ "index": 0, "delta": { "content": "Hello" } }] },
      { "id": "c1", "object": "chat.completion.chunk", "model": "gpt-4o", "choices": [{ "index": 0, "delta": { "content": " there!" } }] },
      { "id": "c1", "object": "chat.completion.chunk", "model": "gpt-4o", "choices": [{ "index": 0, "delta": {}, "finish_reason": "stop" }] },
      { "id": "c1", "object": "chat.completion.chunk", "model": "gpt-4o", "choices": [], "usage": { "prompt_tokens": 5, "completion_tokens": 3, "total_tokens": 8 } }
    ],
    "expected_aggregated_response": {
      "id": "c1",
      "object": "chat.completion",
      "model": "gpt-4o",
      "choices": [
        {
          "index": 0,
          "message": { "role": "assistant", "content": "Hello there!" },
          "finish_reason": "stop"
        }
      ],
      "usage": { "prompt_tokens": 5, "completion_tokens": 3, "total_tokens": 8 }
    }
  },

  {
    "name": "openai_chat_stream_tool_calls",
    "description": "Streaming tool calls: incremental function name and argument deltas merge correctly",
    "inbound_format": "openai_chat",
    "outbound_format": "openai_chat",
    "stream": true,
    "provider_stream_chunks": [
      { "id": "c2", "object": "chat.completion.chunk", "choices": [{ "index": 0, "delta": { "role": "assistant" } }] },
      { "id": "c2", "object": "chat.completion.chunk", "choices": [{ "index": 0, "delta": { "tool_calls": [{ "index": 0, "id": "call_1", "type": "function", "function": { "name": "get_weather", "arguments": "" } }] } }] },
      { "id": "c2", "object": "chat.completion.chunk", "choices": [{ "index": 0, "delta": { "tool_calls": [{ "index": 0, "function": { "arguments": "{\"loc" } }] } }] },
      { "id": "c2", "object": "chat.completion.chunk", "choices": [{ "index": 0, "delta": { "tool_calls": [{ "index": 0, "function": { "arguments": "ation\":\"Tokyo\"}" } }] } }] },
      { "id": "c2", "object": "chat.completion.chunk", "choices": [{ "index": 0, "delta": {}, "finish_reason": "tool_calls" }] }
    ],
    "expected_aggregated_response": {
      "choices": [
        {
          "index": 0,
          "message": {
            "role": "assistant",
            "tool_calls": [
              {
                "index": 0,
                "id": "call_1",
                "type": "function",
                "function": { "name": "get_weather", "arguments": "{\"location\":\"Tokyo\"}" }
              }
            ]
          },
          "finish_reason": "tool_calls"
        }
      ]
    }
  },

  {
    "name": "openai_chat_stream_with_reasoning",
    "description": "Streaming with reasoning_content deltas aggregates reasoning and content separately",
    "inbound_format": "openai_chat",
    "outbound_format": "openai_chat",
    "stream": true,
    "provider_stream_chunks": [
      { "id": "c3", "object": "chat.completion.chunk", "choices": [{ "index": 0, "delta": { "role": "assistant" } }] },
      { "id": "c3", "object": "chat.completion.chunk", "choices": [{ "index": 0, "delta": { "reasoning_content": "Step 1: " } }] },
      { "id": "c3", "object": "chat.completion.chunk", "choices": [{ "index": 0, "delta": { "reasoning_content": "analyze..." } }] },
      { "id": "c3", "object": "chat.completion.chunk", "choices": [{ "index": 0, "delta": { "content": "The answer" } }] },
      { "id": "c3", "object": "chat.completion.chunk", "choices": [{ "index": 0, "delta": { "content": " is 42." } }] },
      { "id": "c3", "object": "chat.completion.chunk", "choices": [{ "index": 0, "delta": {}, "finish_reason": "stop" }] }
    ],
    "expected_aggregated_response": {
      "choices": [
        {
          "message": {
            "role": "assistant",
            "content": "The answer is 42.",
            "reasoning_content": "Step 1: analyze..."
          },
          "finish_reason": "stop"
        }
      ]
    }
  },

  {
    "name": "openai_stream_empty_choices_for_usage_chunk",
    "description": "Usage-only chunk with empty choices array should include choices:[] in output for client compat",
    "inbound_format": "openai_chat",
    "outbound_format": "openai_chat",
    "stream": true,
    "provider_stream_chunks": [
      {
        "id": "c4",
        "object": "chat.completion.chunk",
        "choices": [],
        "usage": { "prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15 }
      }
    ],
    "expected_client_stream_chunks": [
      {
        "note": "choices field must be present as empty array [], not omitted",
        "id": "c4",
        "object": "chat.completion.chunk",
        "choices": [],
        "usage": { "prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15 }
      }
    ]
  },

  {
    "name": "openai_stream_done_marker",
    "description": "Stream [DONE] marker produces correct SSE output",
    "inbound_format": "openai_chat",
    "outbound_format": "openai_chat",
    "stream": true,
    "done_input": { "object": "[DONE]" },
    "expected_done_output": "data: [DONE]\n\n"
  },

  {
    "name": "anthropic_stream_text_to_openai",
    "description": "Anthropic SSE events convert to internal chunks then to OpenAI SSE format",
    "inbound_format": "anthropic",
    "outbound_format": "anthropic",
    "stream": true,
    "outbound_stream_events": [
      { "type": "message_start", "message": { "id": "msg_01", "type": "message", "role": "assistant", "model": "claude-sonnet-4-20250514", "content": [], "usage": { "input_tokens": 10, "output_tokens": 1 } } },
      { "type": "content_block_start", "index": 0, "content_block": { "type": "text", "text": "" } },
      { "type": "content_block_delta", "index": 0, "delta": { "type": "text_delta", "text": "Hello" } },
      { "type": "content_block_delta", "index": 0, "delta": { "type": "text_delta", "text": " world!" } },
      { "type": "content_block_stop", "index": 0 },
      { "type": "message_delta", "delta": { "stop_reason": "end_turn" }, "usage": { "output_tokens": 5 } },
      { "type": "message_stop" }
    ],
    "expected_internal_chunks_sequence": [
      { "note": "message_start → role delta", "choices": [{ "delta": { "role": "assistant" } }] },
      { "note": "text_delta → content delta", "choices": [{ "delta": { "content": "Hello" } }] },
      { "note": "text_delta → content delta", "choices": [{ "delta": { "content": " world!" } }] },
      { "note": "message_delta → finish_reason", "choices": [{ "finish_reason": "stop" }] },
      { "note": "message_stop → usage", "usage": { "prompt_tokens": 10, "completion_tokens": 5 } }
    ]
  },

  {
    "name": "anthropic_stream_thinking_then_text",
    "description": "Anthropic streaming: thinking blocks emit before text blocks with correct SSE event types",
    "inbound_format": "anthropic",
    "outbound_format": "anthropic",
    "stream": true,
    "internal_stream_sequence": [
      { "choices": [{ "delta": { "role": "assistant" } }] },
      { "choices": [{ "delta": { "reasoning_content": "Thinking step 1..." } }] },
      { "choices": [{ "delta": { "reasoning_content": " Step 2." } }] },
      { "choices": [{ "delta": { "reasoning_signature": "sig_abc" } }] },
      { "choices": [{ "delta": { "content": "The answer " } }] },
      { "choices": [{ "delta": { "content": "is 4." } }] },
      { "choices": [{ "finish_reason": "stop" }] },
      { "usage": { "prompt_tokens": 20, "completion_tokens": 30, "total_tokens": 50 } }
    ],
    "expected_anthropic_events_contain": [
      { "event": "message_start" },
      { "event": "content_block_start", "content_block": { "type": "thinking" } },
      { "event": "content_block_delta", "delta": { "type": "thinking_delta" } },
      { "event": "content_block_delta", "delta": { "type": "signature_delta" } },
      { "event": "content_block_stop" },
      { "event": "content_block_start", "content_block": { "type": "text" } },
      { "event": "content_block_delta", "delta": { "type": "text_delta" } },
      { "event": "content_block_stop" },
      { "event": "message_delta", "delta": { "stop_reason": "end_turn" } },
      { "event": "message_stop" }
    ]
  },

  {
    "name": "anthropic_stream_tool_calls",
    "description": "Anthropic streaming: tool_use blocks emit content_block_start with tool info then input_json_delta",
    "inbound_format": "anthropic",
    "outbound_format": "anthropic",
    "stream": true,
    "internal_stream_sequence": [
      { "choices": [{ "delta": { "role": "assistant" } }] },
      { "choices": [{ "delta": { "content": "Let me check." } }] },
      { "choices": [{ "delta": { "tool_calls": [{ "index": 0, "id": "call_1", "type": "function", "function": { "name": "search", "arguments": "" } }] } }] },
      { "choices": [{ "delta": { "tool_calls": [{ "index": 0, "function": { "arguments": "{\"q\":" } }] } }] },
      { "choices": [{ "delta": { "tool_calls": [{ "index": 0, "function": { "arguments": "\"test\"}" } }] } }] },
      { "choices": [{ "finish_reason": "tool_calls" }] }
    ],
    "expected_anthropic_events_contain": [
      { "event": "content_block_start", "content_block": { "type": "text" } },
      { "event": "content_block_delta", "delta": { "type": "text_delta" } },
      { "event": "content_block_stop" },
      { "event": "content_block_start", "content_block": { "type": "tool_use", "id": "call_1", "name": "search" } },
      { "event": "content_block_delta", "delta": { "type": "input_json_delta" } },
      { "event": "content_block_stop" },
      { "event": "message_delta", "delta": { "stop_reason": "tool_use" } }
    ]
  },

  {
    "name": "anthropic_stream_multiple_tool_calls",
    "description": "Multiple sequential tool_use blocks in Anthropic stream emit separate content_block_start/stop pairs",
    "inbound_format": "anthropic",
    "outbound_format": "anthropic",
    "stream": true,
    "internal_stream_sequence": [
      { "choices": [{ "delta": { "role": "assistant" } }] },
      { "choices": [{ "delta": { "tool_calls": [{ "index": 0, "id": "call_a", "type": "function", "function": { "name": "func_a", "arguments": "{}" } }] } }] },
      { "choices": [{ "delta": { "tool_calls": [{ "index": 1, "id": "call_b", "type": "function", "function": { "name": "func_b", "arguments": "{}" } }] } }] },
      { "choices": [{ "finish_reason": "tool_calls" }] }
    ],
    "expected_anthropic_events_contain": [
      { "event": "content_block_start", "index": 0, "content_block": { "type": "tool_use", "id": "call_a" } },
      { "event": "content_block_stop" },
      { "event": "content_block_start", "index": 1, "content_block": { "type": "tool_use", "id": "call_b" } },
      { "event": "content_block_stop" }
    ]
  },

  {
    "name": "gemini_stream_chunks",
    "description": "Gemini streaming response chunks convert to internal stream format",
    "inbound_format": "openai_chat",
    "outbound_format": "gemini",
    "stream": true,
    "provider_stream_chunks_gemini": [
      {
        "candidates": [{ "content": { "parts": [{ "text": "Hello" }], "role": "model" }, "index": 0 }]
      },
      {
        "candidates": [{ "content": { "parts": [{ "text": " world!" }], "role": "model" }, "index": 0, "finishReason": "STOP" }],
        "usageMetadata": { "promptTokenCount": 5, "candidatesTokenCount": 3, "totalTokenCount": 8 }
      }
    ],
    "expected_internal_chunks": [
      { "object": "chat.completion.chunk", "choices": [{ "delta": { "role": "assistant", "content": "Hello" } }] },
      { "object": "chat.completion.chunk", "choices": [{ "delta": { "content": " world!" }, "finish_reason": "stop" }] }
    ]
  },

  {
    "name": "anthropic_stream_done_returns_nil",
    "description": "Anthropic inbound TransformStream returns nil for [DONE] marker (no SSE output)",
    "inbound_format": "anthropic",
    "stream": true,
    "done_input": { "object": "[DONE]" },
    "expected_done_output": null,
    "notes": "Anthropic SSE format doesn't use [DONE]; message_stop is the terminal event"
  }
]
